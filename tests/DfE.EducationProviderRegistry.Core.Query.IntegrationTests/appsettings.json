{
    "PostgresDatabaseOptions": {
        "Database": "postgres",
        "Username": "postgres",
        "Password": "postgres"
    },
    "ContainerOptions": {
        "HostName": "host.docker.internal",
        "Registry": "ghcr.io",
        "Owner": "dfe-digital",
        "ImageName": "education-provider-registry-data-postgres",
        "ImageTag": "main",
        "Digest": "",
        "PortMappings":  [],
        "StartupArguments": [
            {
                "Key": "-c",
                "Value": [ "fsync=off" ]
            },
            {
                "Key": "-c",
                "Value": [ "full_page_writes=off" ]
            },
            {
                "Key": "-c",
                "Value": [ "synchronous_commit=off" ]
            },
            {
                "Key": "-c",
                "Value": [ "shared_preload_libraries=pg_stat_statements" ]
            },
            {
                "Key": "-c",
                "Value": [ "pg_stat_statements.track=all" ]
            },
            {
                "Key": "-c",
                "Value": [ "pg_stat_statements.max=10000" ]
            }
        ]
    }
}
