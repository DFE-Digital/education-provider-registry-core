{
    "PostgresDatabaseOptions": {
        "Database": "postgres",
        "Username": "postgres",
        "Password": "postgres"
    },
    "PostgresContainerOptions": {
        "ImageName": "postgres",
        "ImageTag": "16",
        //"PublicPort": 5432,
        "ServerArgs": [
            {
                "Key": "-c",
                "Value": [ "fsync=off" ]
            },
            {
                "Key": "-c",
                "Value": [ "full_page_writes=off" ]
            },
            {
                "Key": "-c",
                "Value": [ "synchronous_commit=off" ]
            },
            {
                "Key": "-c",
                "Value": [ "shared_preload_libraries=pg_stat_statements" ]
            },
            {
                "Key": "-c",
                "Value": [ "pg_stat_statements.track=all" ]
            },
            {
                "Key": "-c",
                "Value": [ "pg_stat_statements.max=10000" ]
            }
        ],
        "CopyBeforeContainerInit": []
    }
}
