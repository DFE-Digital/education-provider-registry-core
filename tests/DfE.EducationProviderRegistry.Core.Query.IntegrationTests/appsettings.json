{
  "ContainerNetworkOptions": {
      "Networks": []
  },
  "PostgresContainerOptions": {
    "Container": {
      "Registry": "ghcr.io",
        "Owner": "dfe-digital",
        "ImageName": "education-provider-registry-data-postgres",
        "ImageTag": "main",
        "Digest": "",
        "PortMappings": [
          {
            "ContainerPort": 5432,
            "PublicPort": null
          }
        ],
        "StartupArguments": [
          {
            "Key": "-c",
            "Value": [ "fsync=off" ]
          },
          {
            "Key": "-c",
            "Value": [ "full_page_writes=off" ]
          },
          {
            "Key": "-c",
            "Value": [ "synchronous_commit=off" ]
          },
          {
            "Key": "-c",
            "Value": [ "shared_preload_libraries=pg_stat_statements" ]
          },
          {
            "Key": "-c",
            "Value": [ "pg_stat_statements.track=all" ]
          },
          {
            "Key": "-c",
            "Value": [ "pg_stat_statements.max=10000" ]
          }
        ],
      "Networks": []
    },
    "Database": {
      "Name": "postgres",
      "Username": "postgres",
      "Password": "postgres"
    }
  }
}
