{
    "PostgresDatabaseOptions": {
        "Database": "postgres",
        "Username": "postgres",
        "Password": "postgres"
    },
    "ContainerOptions": {
        "ImageName": "ghcr.io/dfe-digital/education-provider-registry-data-postgres",
        "ImageTag": "main",
        "StartupArguments": [
            {
                "Key": "-c",
                "Value": [ "fsync=off" ]
            },
            {
                "Key": "-c",
                "Value": [ "full_page_writes=off" ]
            },
            {
                "Key": "-c",
                "Value": [ "synchronous_commit=off" ]
            },
            {
                "Key": "-c",
                "Value": [ "shared_preload_libraries=pg_stat_statements" ]
            },
            {
                "Key": "-c",
                "Value": [ "pg_stat_statements.track=all" ]
            },
            {
                "Key": "-c",
                "Value": [ "pg_stat_statements.max=10000" ]
            }
        ]
    }
}
